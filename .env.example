# Copy to .env locally. Never commit .env or credential values.
# Use a NEW Supabase project dedicated solely to this tool.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_20_CHARACTER_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Must be an address on a domain verified with Resend; use your real recipient.
DIGEST_FROM=jobs@example.com
DIGEST_TO=you@example.com
# Optional non-secret path; default config/sources.json
SOURCES_CONFIG=config/sources.json
